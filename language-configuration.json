{
    "comments": {
        "lineComment": "--"
    },
    "brackets": [
        ["(", ")"]
    ],
    "autoClosingPairs": [
        { "open": "(", "close": ")", "notIn": ["string", "comment"] },
        { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
    ],
    "surroundingPairs": [
        ["(", ")"],
        ["\"", "\""]
    ],
    "wordPattern": "(\\d+\\.\\d+(E[+-]?\\d+)?)|([!$']?[A-Za-z0-9_$]+)"
}
