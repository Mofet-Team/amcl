{
  "name": "amcl",
  "displayName": "amcl",
  "description": "Language support for Honeywell TDC 3000 / TPS Control Language (CL/HPM, CL/APM, CL/PM, CL/AM)",
  "icon": "icon.png",
  "version": "0.10.3",
  "publisher": "bazdalaz",
  "author": {
    "email": "bazdalaz@gmail.com",
    "name": "Leonid"
  },
  "galleryBanner": {
    "color": "#0000FF",
    "theme": "dark"
  },
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/Mofet-Team/amcl/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mofet-Team/amcl.git"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "Honeywell",
    "TDC 3000",
    "TPS",
    "CL",
    "Control Language",
    "HPM",
    "Application Module"
  ],
  "main": "./dist/client.js",
  "activationEvents": [
    "onLanguage:cl",
    "onLanguage:cl-listing",
    "workspaceContains:**/*.{CL,cl}"
  ],
  "contributes": {
    "configurationDefaults": {
      "[cl]": {
        "files.encoding": "windows1255",
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.detectIndentation": false,
        "editor.rulers": [
          132
        ],
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": false
        },
        "outline.collapseItems": "alwaysCollapse",
        "editor.inlayHints.enabled": "offUnlessPressed"
      },
      "[cl-listing]": {
        "files.encoding": "windows1255",
        "editor.insertSpaces": true
      }
    },
    "configuration": {
      "title": "CL (Honeywell TDC 3000)",
      "properties": {
        "amcl.pointDatabase": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "window",
          "markdownDescription": "Folders or `.EB` files exported from the TPS point database (Exception Build). Absolute, `~/`, or relative to the workspace folder. `.EB` files inside the workspace are always read.\n\nWith them the extension knows which HPM each sequence runs in, so `!BOX` variables link up across sequences, and points can be looked up by name."
        },
        "amcl.networkConfig": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "window",
          "markdownDescription": "Network configuration files (`NCF.XX`) of your LCNs, or folders holding them. They only name LCNs: which LCN each point is on is worked out from the code, and HPMs are identified by LCN, UCN and node. With `A/sys/NCF.XX` and `B/sys/NCF.XX` the LCNs are shown as A and B."
        },
        "amcl.inlayHints.locals": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Show the storage element a LOCAL is mapped onto after each use of it, such as `NN(12)` or `!BOX.FL(3)`. In CL files inlay hints show while Ctrl+Alt (Ctrl+Option on a Mac) is held; set `#editor.inlayHints.enabled#` to `on` for `[cl]` to show them always."
        },
        "amcl.inlayHints.points": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Show the descriptor from the point database (the point type in brackets when it has none) after each use of a point, once per line, and after its `EXTERNAL` entry and the bound point of a program; hover the hint for both."
        },
        "amcl.hebrewDescriptors": {
          "type": "string",
          "enum": [
            "auto",
            "asStored"
          ],
          "default": "auto",
          "scope": "window",
          "enumDescriptions": [
            "Detect descriptors stored in visual order (as the TPS stores them) and show them in logical order",
            "Show descriptors exactly as stored in the point database"
          ],
          "markdownDescription": "How Hebrew point descriptors from the point database are shown in hovers."
        },
        "amcl.lineLength": {
          "type": "number",
          "default": 132,
          "minimum": 40,
          "scope": "window",
          "markdownDescription": "Characters per line past which code is reported (`line-length`). The compiler reads 132 columns and drops the rest of a line without a message; set a lower value if an editor or file transfer on the TPS cuts lines sooner. Comments past the limit are not reported."
        },
        "amcl.diagnostics.disabled": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "syntax",
              "undefined",
              "unused",
              "string-length",
              "send-length",
              "loop-never-repeated",
              "loop-label",
              "serial-iop",
              "remote-access",
              "name-length",
              "slot-range",
              "mixed-logic",
              "decl-after-phase",
              "duplicate",
              "dialect",
              "external-bound",
              "external-in-subroutine",
              "const-expr",
              "step-size",
              "call-depth",
              "wait-absolute",
              "local-location",
              "local-alias",
              "local-type",
              "array-bounds",
              "external-order",
              "loop-counter",
              "loop-range",
              "repeat",
              "handler",
              "initiate",
              "structure",
              "heading",
              "call-args",
              "argument-mode",
              "parameter",
              "read-only",
              "external-ucn",
              "prefetch",
              "line-length",
              "state-change",
              "undeclared-point",
              "compiler-error",
              "compiler-warning",
              "compiler-note",
              "compiler-stale"
            ]
          },
          "default": [],
          "scope": "window",
          "markdownDescription": "Diagnostic codes not to report, for example `unused` or `remote-access` (which is only as current as the point database). The code is shown with each problem. `compiler-error`, `compiler-warning` and `compiler-note` are messages from the `.LS`/`.LE` listings next to a source; `compiler-stale` reports listing messages on lines changed since that compile."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": ".clformat.json",
        "url": "./schemas/clformat.schema.json"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "amclPrograms",
          "name": "CL Programs",
          "icon": "$(server)",
          "when": "amcl.hasPrograms"
        },
        {
          "id": "amclStorage",
          "name": "CL Shared Storage",
          "icon": "$(database)",
          "when": "amcl.hasPrograms",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "amcl.createFormatRules",
        "title": "Create Formatting Rules from This File",
        "category": "CL"
      },
      {
        "command": "amcl.refreshPrograms",
        "title": "Refresh",
        "category": "CL",
        "icon": "$(refresh)"
      },
      {
        "command": "amcl.compareWithCompile",
        "title": "Compare with Last Compile",
        "category": "CL",
        "icon": "$(git-compare)"
      },
      {
        "command": "amcl.whoStores",
        "title": "Who Stores to This",
        "category": "CL"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "amcl.createFormatRules",
          "when": "editorLangId == cl"
        },
        {
          "command": "amcl.refreshPrograms",
          "when": "amcl.hasPrograms"
        },
        {
          "command": "amcl.compareWithCompile",
          "when": "editorLangId == cl"
        },
        {
          "command": "amcl.whoStores",
          "when": "editorLangId == cl || editorLangId == cl-listing"
        }
      ],
      "editor/title": [
        {
          "command": "amcl.compareWithCompile",
          "when": "resourceLangId == cl && resourceScheme == file",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "amcl.whoStores",
          "when": "editorLangId == cl || editorLangId == cl-listing",
          "group": "navigation@5"
        },
        {
          "command": "amcl.compareWithCompile",
          "when": "resourceLangId == cl && resourceScheme == file",
          "group": "navigation@90"
        }
      ],
      "editor/title/context": [
        {
          "command": "amcl.compareWithCompile",
          "when": "resourceLangId == cl && resourceScheme == file",
          "group": "3_compare"
        }
      ],
      "explorer/context": [
        {
          "command": "amcl.compareWithCompile",
          "when": "resourceLangId == cl",
          "group": "3_compare"
        }
      ],
      "view/item/context": [
        {
          "command": "amcl.compareWithCompile",
          "when": "view == amclPrograms && viewItem == program",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "amcl.refreshPrograms",
          "when": "view == amclPrograms || view == amclStorage",
          "group": "navigation"
        }
      ]
    },
    "languages": [
      {
        "id": "cl",
        "aliases": [
          "CL",
          "cl"
        ],
        "extensions": [
          ".CL",
          ".EC"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "cl-listing",
        "aliases": [
          "CL Listing"
        ],
        "extensions": [
          ".LS",
          ".LE"
        ],
        "configuration": "./listing-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cl",
        "scopeName": "source.cl",
        "path": "./syntaxes/cl.tmLanguage.json"
      },
      {
        "path": "./syntaxes/injection.json",
        "scopeName": "todo-comment.injection",
        "injectTo": [
          "source.cl"
        ]
      },
      {
        "language": "cl-listing",
        "scopeName": "text.cl-listing",
        "path": "./syntaxes/cl-listing.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.source.cl": "cl"
        }
      }
    ],
    "snippets": [
      {
        "language": "cl",
        "path": "./snippets/snippets.json"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1",
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-textdocument": "1.0.12",
    "vscode-uri": "3.0.8"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "20.17.6",
    "@types/vscode": "1.82.0",
    "@vscode/vsce": "3.2.1",
    "esbuild": "0.24.0",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.2",
    "vitest": "2.1.9"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "pretest": "node esbuild.mjs",
    "test": "vitest run",
    "corpus": "node esbuild.mjs --corpus && node dist/corpus.js",
    "vscode:prepublish": "npm run typecheck && npm run lint && node esbuild.mjs --production",
    "package": "vsce package --out dist/amcl.vsix",
    "install-local": "sh scripts/install-local.sh"
  }
}
