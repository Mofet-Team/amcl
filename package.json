{
  "name": "amcl",
  "displayName": "amcl",
  "description": "Language support for Honeywell TDC 3000 / TPS Control Language (CL/HPM, CL/APM, CL/PM, CL/AM)",
  "icon": "icon.png",
  "version": "0.4.0",
  "publisher": "bazdalaz",
  "author": {
    "email": "bazdalaz@gmail.com",
    "name": "Leonid"
  },
  "galleryBanner": {
    "color": "#0000FF",
    "theme": "dark"
  },
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/Mofet-Team/amcl/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mofet-Team/amcl.git"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "Honeywell",
    "TDC 3000",
    "TPS",
    "CL",
    "Control Language",
    "HPM",
    "Application Module"
  ],
  "main": "./dist/client.js",
  "activationEvents": [
    "onLanguage:cl"
  ],
  "contributes": {
    "configurationDefaults": {
      "[cl]": {
        "files.encoding": "windows1255",
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.detectIndentation": false,
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": false
        },
        "outline.collapseItems": "alwaysCollapse"
      },
      "[cl-listing]": {
        "files.encoding": "windows1255",
        "editor.insertSpaces": true
      }
    },
    "configuration": {
      "title": "CL (Honeywell TDC 3000)",
      "properties": {
        "amcl.pointDatabase": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "window",
          "markdownDescription": "Folders or `.EB` files exported from the TPS point database (Exception Build). Absolute, `~/`, or relative to the workspace folder. `.EB` files inside the workspace are always read.\n\nWith them the extension knows which HPM each sequence runs in, so `!BOX` variables link up across sequences, and points can be looked up by name."
        },
        "amcl.networkConfig": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "window",
          "markdownDescription": "Network configuration files (`NCF.XX`) of your LCNs, or folders holding them. They only name LCNs: which LCN each point is on is worked out from the code, and HPMs are identified by LCN, UCN and node. With `A/sys/NCF.XX` and `B/sys/NCF.XX` the LCNs are shown as A and B."
        },
        "amcl.hebrewDescriptors": {
          "type": "string",
          "enum": [
            "auto",
            "asStored"
          ],
          "default": "auto",
          "scope": "window",
          "enumDescriptions": [
            "Detect descriptors stored in visual order (as the TPS stores them) and show them in logical order",
            "Show descriptors exactly as stored in the point database"
          ],
          "markdownDescription": "How Hebrew point descriptors from the point database are shown in hovers."
        },
        "amcl.diagnostics.disabled": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "syntax",
              "undefined",
              "unused",
              "string-length",
              "send-length",
              "loop-never-repeated",
              "loop-label",
              "serial-iop",
              "remote-access",
              "name-length",
              "slot-range",
              "mixed-logic",
              "decl-after-phase",
              "duplicate",
              "dialect",
              "external-bound",
              "external-in-subroutine",
              "const-expr",
              "step-size",
              "call-depth",
              "wait-absolute"
            ]
          },
          "default": [],
          "scope": "window",
          "markdownDescription": "Diagnostic codes not to report, for example `unused` or `remote-access` (which is only as current as the point database). The code is shown with each problem."
        }
      }
    },
    "languages": [
      {
        "id": "cl",
        "aliases": [
          "CL",
          "cl"
        ],
        "extensions": [
          ".CL",
          ".EC"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "cl-listing",
        "aliases": [
          "CL Listing"
        ],
        "extensions": [
          ".LS",
          ".LE"
        ],
        "configuration": "./listing-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cl",
        "scopeName": "source.cl",
        "path": "./syntaxes/cl.tmLanguage.json"
      },
      {
        "path": "./syntaxes/injection.json",
        "scopeName": "todo-comment.injection",
        "injectTo": [
          "source.cl"
        ]
      },
      {
        "language": "cl-listing",
        "scopeName": "text.cl-listing",
        "path": "./syntaxes/cl-listing.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.source.cl": "cl"
        }
      }
    ],
    "snippets": [
      {
        "language": "cl",
        "path": "./snippets/snippets.json"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1",
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-textdocument": "1.0.12"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "20.17.6",
    "@types/vscode": "1.82.0",
    "@vscode/vsce": "3.2.1",
    "esbuild": "0.24.0",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.2",
    "vitest": "2.1.9"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "pretest": "node esbuild.mjs",
    "test": "vitest run",
    "corpus": "node esbuild.mjs --corpus && node dist/corpus.js",
    "vscode:prepublish": "npm run typecheck && npm run lint && node esbuild.mjs --production",
    "package": "vsce package --out dist/amcl.vsix",
    "install-local": "sh scripts/install-local.sh"
  }
}
