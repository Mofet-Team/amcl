{
  "scopeName": "todo-comment.injection",
  "injectionSelector": "L:comment.line.double-dash.cl",
  "patterns": [
    { "include": "#task" },
    { "include": "#section-header" }
  ],
  "repository": {
    "task": {
      "match": "(?i)\\b(TODO|FIXME|REVIEW|XXX|HACK)\\b.*$",
      "name": "markup.bold.task.cl"
    },
    "section-header": {
      "match": "(?i)\\G\\s*((?:MOD|BOX)\\s+(?:NUMERICS?|FLAGS?|TIMES?|STRINGS?)|CONST(?:ANTS?)?)\\b.*$",
      "name": "markup.heading.section.cl"
    }
  }
}
