{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CL",
  "scopeName": "source.cl",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#directive"
    },
    {
      "include": "#continuation"
    },
    {
      "include": "#string"
    },
    {
      "include": "#label-definition"
    },
    {
      "include": "#external-declaration"
    },
    {
      "include": "#state-change"
    },
    {
      "include": "#headings"
    },
    {
      "include": "#references"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#points"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-dash.cl",
      "begin": "--",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.cl"
        }
      },
      "end": "$"
    },
    "directive": {
      "match": "(?i)^(%(?:PAGE|DEBUG|INCLUDE_SOURCE|INCLUDE_EQUIPMENT_LIST|INCLUDE_SET|RELAX))\\b(?:\\s+(\\S+))?",
      "captures": {
        "1": {
          "name": "keyword.control.directive.cl"
        },
        "2": {
          "name": "string.unquoted.include.cl"
        }
      }
    },
    "continuation": {
      "match": "^&",
      "name": "punctuation.separator.continuation.cl"
    },
    "string": {
      "name": "string.quoted.double.cl",
      "begin": "\"",
      "end": "\"|$",
      "applyEndPatternLast": true,
      "patterns": [
        {
          "match": "\"\"",
          "name": "constant.character.escape.cl"
        }
      ]
    },
    "label-definition": {
      "match": "(?i)^\\s*(?!(?:SEND|LOCAL|PARAMETER)\\b)([A-Za-z0-9_$]+)\\s*(:)(?!=)",
      "captures": {
        "1": {
          "name": "entity.name.label.cl"
        },
        "2": {
          "name": "punctuation.separator.label.cl"
        }
      }
    },
    "external-declaration": {
      "begin": "(?i)^\\s*(EXTERNAL)\\b",
      "beginCaptures": {
        "1": {
          "name": "storage.modifier.external.cl"
        }
      },
      "while": "^&",
      "whileCaptures": {
        "0": {
          "name": "punctuation.separator.continuation.cl"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#points"
        },
        {
          "match": "[A-Za-z0-9_$]+",
          "name": "entity.name.tag.data-point.cl"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "headings": {
      "patterns": [
        {
          "match": "(?i)^\\s*(SEQUENCE|BLOCK)\\s+([A-Za-z0-9_$']+)",
          "captures": {
            "1": {
              "name": "storage.type.program.cl"
            },
            "2": {
              "name": "entity.name.function.program.cl"
            }
          }
        },
        {
          "match": "(?i)\\(\\s*(HPM|APM|PM|MC)\\s*;",
          "captures": {
            "1": {
              "name": "support.type.dialect.cl"
            }
          }
        },
        {
          "match": "(?i)^\\s*(PHASE|STEP)\\s+([A-Za-z0-9_$']+)",
          "captures": {
            "1": {
              "name": "storage.type.section.cl"
            },
            "2": {
              "name": "entity.name.section.cl"
            }
          }
        },
        {
          "match": "(?i)^\\s*(HOLD|SHUTDOWN|EMERGENCY)\\s+(HANDLER)\\s+([A-Za-z0-9_$']+)",
          "captures": {
            "1": {
              "name": "storage.type.handler.cl"
            },
            "2": {
              "name": "storage.type.handler.cl"
            },
            "3": {
              "name": "entity.name.function.handler.cl"
            }
          }
        },
        {
          "match": "(?i)^\\s*(SUBROUTINE)\\s+([A-Za-z0-9_$']+)",
          "captures": {
            "1": {
              "name": "storage.type.function.cl"
            },
            "2": {
              "name": "entity.name.function.cl"
            }
          }
        },
        {
          "match": "(?i)^\\s*(PARAM_LIST|ENUMERATION)\\s+([A-Za-z0-9_$']+)",
          "captures": {
            "1": {
              "name": "storage.type.cl"
            },
            "2": {
              "name": "entity.name.type.cl"
            }
          }
        },
        {
          "match": "(?i)\\b(DEFINE)\\s+([A-Za-z0-9_$']+)",
          "captures": {
            "1": {
              "name": "storage.type.function.cl"
            },
            "2": {
              "name": "entity.name.function.cl"
            }
          }
        },
        {
          "match": "(?i)^\\s*(END)\\s+(PACKAGE|CUSTOM)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.end.cl"
            },
            "2": {
              "name": "storage.type.cl"
            }
          }
        },
        {
          "match": "(?i)^\\s*(END)\\s+([A-Za-z0-9_$']+)",
          "captures": {
            "1": {
              "name": "keyword.control.end.cl"
            },
            "2": {
              "name": "entity.name.function.cl"
            }
          }
        },
        {
          "match": "(?i)^\\s*(PACKAGE|CUSTOM)\\b",
          "name": "storage.type.cl"
        }
      ]
    },
    "references": {
      "patterns": [
        {
          "match": "(?i)\\b(INITIATE)\\s+(?!(?:HOLD|SHUTDOWN|EMERGENCY)\\b)([A-Za-z0-9_$]+)",
          "captures": {
            "1": {
              "name": "keyword.control.cl"
            },
            "2": {
              "name": "entity.name.tag.data-point.cl"
            }
          }
        },
        {
          "match": "(?i)\\b(GOTO|RESUME)\\s+(STEP|PHASE)\\s+([A-Za-z0-9_$']+)",
          "captures": {
            "1": {
              "name": "keyword.control.cl"
            },
            "2": {
              "name": "keyword.control.cl"
            },
            "3": {
              "name": "entity.name.section.cl"
            }
          }
        },
        {
          "match": "(?i)\\b(GOTO|REPEAT)\\s+([A-Za-z0-9_$']+)",
          "captures": {
            "1": {
              "name": "keyword.control.cl"
            },
            "2": {
              "name": "entity.name.label.cl"
            }
          }
        },
        {
          "match": "(?i)\\b(CALL)\\s+([A-Za-z0-9_$']+)",
          "captures": {
            "1": {
              "name": "keyword.control.cl"
            },
            "2": {
              "name": "entity.name.function.cl"
            }
          }
        },
        {
          "match": "(?i)\\b(HOLD|SHUTDOWN|EMERGENCY)\\s+(?!HANDLER\\b)([A-Za-z0-9_$']+)",
          "captures": {
            "1": {
              "name": "storage.type.handler.cl"
            },
            "2": {
              "name": "entity.name.function.handler.cl"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "(?i)\\b(IF|THEN|ELSE|WHEN|OTHERS|ERROR|GOTO|LOOP|FOR|REPEAT|CALL|EXIT|ABORT|FAIL|END|PAUSE|WAIT|RESUME|RESTART|INITIATE|ENB|SEND|SET|READ|WRITE|FROM)\\b",
          "name": "keyword.control.cl"
        },
        {
          "match": "(?i)\\b(SEQUENCE|BLOCK|PHASE|STEP|SUBROUTINE|HANDLER|HOLD|SHUTDOWN|EMERGENCY|PACKAGE|CUSTOM|PARAM_LIST|ENUMERATION)\\b",
          "name": "storage.type.cl"
        },
        {
          "match": "(?i)\\b(LOCAL|EXTERNAL|PARAMETER|DEFINE|AT|ARRAY|POINT|GENERIC|KEEPENB|ALARM|VALUE|EU|ACCESS|CLASS|BLD_VISIBLE|RANGE|HELP|PARALLEL)\\b",
          "name": "storage.modifier.cl"
        },
        {
          "match": "(?i)\\b(FAIL_IF_ERROR|IGNORE_IF_ERROR|INVOKE_IF_ERROR|LOG_ONLY|CRT_ONLY|ACP)\\b",
          "name": "keyword.other.cl"
        },
        {
          "match": "(?i)\\b(DAYS|HOURS|MINS|SECS)\\b",
          "name": "keyword.other.unit.time.cl"
        },
        {
          "match": "(?i)\\b(AND|OR|XOR|NOT|MOD|IN|OUT)\\b",
          "name": "keyword.operator.word.cl"
        }
      ]
    },
    "types": {
      "match": "(?i)\\b(NUMBER|LOGICAL|STRING|TIME)\\b(?!\\s*\\()",
      "name": "storage.type.primitive.cl"
    },
    "builtins": {
      "patterns": [
        {
          "match": "(?i)\\b(ABS|ATAN|COS|EXP|INT|LN|LOG10|ROUND|SIN|SQRT|TAN|AVG|MAX|MIN|SUM|DATE_TIME|NOW|NUMBER|LEN|EQUAL_STRING|BADVAL|FINITE|ORD|SELF|EXISTS|COMM_ERROR|EQUAL_POINT_ID|EQUAL_NULL_POINT_ID|BKG_SWITCHOVER_RESTART)\\b",
          "name": "support.function.builtin.cl"
        },
        {
          "match": "(?i)\\b(SET_BAD|ALLOW_BAD|MODIFY_STRING|NUMBER_TO_STRING|MOVE_PARAMETER|ENUM_VALUE_STORE|SET_NULL_POINT_ID|GET_CL_SLOT|BKG_DELAY|BKG_CHANGE_PRIORITY|CDS_READ|CDS_WRITE|DELETE_FILE)\\b",
          "name": "support.function.builtin.subroutine.cl"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "match": "(?i)\\b(ON|OFF)\\b",
          "name": "constant.language.logical.cl"
        },
        {
          "match": "(?i)\\b(PRE_GI|PRE_PVPR|PRE_PVAG|PV_ALG|PST_PVAG|PST_PVFL|PRE_PVA|PST_PVPR|PRE_CTPR|PRE_SP|PRE_CTAG|CTL_ALG|PST_CTAG|PST_CTPR|PST_GO|BACKGRND|GENERAL|CONTIN_CTRL|ENTITY_BLDR)\\b",
          "name": "constant.language.insertion-point.cl"
        },
        {
          "match": "(?i)\\b(MAN|AUTO|CAS|BCAS|NORMAL|OPERATOR|PROGRAM|SUPERVISOR|ENGINEER|NONE|BAD|UNCERTN|INACTIVE|ACTIVE|ENABLE|DISABLE|INHIBIT|BASIC|FULL|START|STOP|RESET|RESTSTRT|OPEN|CLOSE|RUN|MOVING|SEMIAUTO|SNGLSTEP|NORM|SHDN|EMSD|STRT|LOADED|PERMIT|NOTPERM)\\b",
          "name": "constant.language.enum.cl"
        }
      ]
    },
    "points": {
      "patterns": [
        {
          "match": "(?i)(![A-Z]+[0-9A-Z]*)\\b",
          "name": "variable.language.hardware.cl"
        },
        {
          "match": "(\\$[A-Za-z0-9_]+)",
          "name": "variable.language.system.cl"
        },
        {
          "match": "\\b([A-Za-z0-9_]+)(\\\\)([A-Za-z0-9_$]+)",
          "captures": {
            "1": {
              "name": "entity.name.namespace.cl"
            },
            "2": {
              "name": "punctuation.separator.namespace.cl"
            },
            "3": {
              "name": "entity.name.tag.data-point.cl"
            }
          }
        },
        {
          "match": "(?i)\\b(NN|FL|TIME|STR8|STR16|STR32|STR64)(?=\\s*\\()",
          "name": "variable.language.slot.cl"
        },
        {
          "match": "\\b([A-Za-z0-9_$]+)(\\.)([A-Za-z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "entity.name.tag.data-point.cl"
            },
            "2": {
              "name": "punctuation.accessor.cl"
            },
            "3": {
              "name": "variable.other.member.parameter.cl"
            }
          }
        },
        {
          "match": "(?<=\\.)([A-Za-z][A-Za-z0-9_]*)",
          "name": "variable.other.member.parameter.cl"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b\\d+\\.\\d+(?:[eE][+-]?\\d+)?\\b",
          "name": "constant.numeric.float.cl"
        },
        {
          "match": "\\b\\d+\\b",
          "name": "constant.numeric.integer.cl"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "\\.\\.",
          "name": "keyword.operator.range.cl"
        },
        {
          "match": "<>|<=|>=|<|>",
          "name": "keyword.operator.comparison.cl"
        },
        {
          "match": "\\*\\*|[-+*/]",
          "name": "keyword.operator.arithmetic.cl"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.cl"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": ";",
          "name": "punctuation.terminator.cl"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.cl"
        },
        {
          "match": ":",
          "name": "punctuation.separator.colon.cl"
        }
      ]
    },
    "state-change": {
      "begin": "(?i)(?:^|(?<=\\bTHEN)|(?<=\\bELSE)|(?<=[(;:&]))\\s*(OPEN|CLOSE|START|STOP|RUN|RESET|RESTSTRT|ON|OFF|HIGH|LOW|MAN|AUTO|CAS|NORMAL)\\s+(?=[A-Za-z0-9_$!])(?!(?:THEN|ELSE|AND|OR|XOR|WHEN)\\b)",
      "beginCaptures": {
        "1": {
          "name": "constant.language.enum.cl"
        }
      },
      "end": "(?=[;()]|--)|^(?!&)",
      "patterns": [
        {
          "include": "#continuation"
        },
        {
          "include": "#points"
        },
        {
          "match": "[A-Za-z0-9_$]+",
          "name": "entity.name.tag.data-point.cl"
        },
        {
          "include": "#punctuation"
        }
      ]
    }
  }
}
