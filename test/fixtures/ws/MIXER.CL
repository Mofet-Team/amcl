    SEQUENCE MIXER (HPM; POINT MIXER)
    EXTERNAL !BOX, DOSER, TANK_LVL, ARR1, XV1, FT100
    LOCAL AGITATE: LOGICAL AT !BOX.FL(21)
    LOCAL DOSE_QTY AT DOSER.NN(5)
    LOCAL LEVEL AT !BOX.NN(300)
    PHASE RUN
    SET AGITATE = ON
    SET DOSE_QTY = TANK_LVL.PV * 2
    IF ARR1.FL(2) = ON THEN SET LEVEL = 0
    INITIATE DOSER
    IF FT100.PV > 5.0 THEN CLOSE XV1
    END MIXER
