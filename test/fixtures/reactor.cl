-- Synthetic CL/HPM sequence covering the structures the language server handles.
    SEQUENCE REACT1 (HPM; POINT REACT1)
    EXTERNAL !BOX, $NM01N05, FV101, PUMP1,
&       TI100, REACT2
    LOCAL FAGIT: LOGICAL AT !BOX.FL(21)   -- box flag
    LOCAL NBATCH AT NN(1)
    LOCAL NTEMP AT REACT2.NN(41)
    LOCAL T1: TIME AT TIME(1)
    LOCAL STATES: OPEN/CLOSE AT FL(2)
    LOCAL I AT NN(2)
    LOCAL TMAX = 85.5

    PHASE PREPARE (ALARM 5 MINS; HOLD HLD1)
STEP ST01
    ENB SHUTDOWN SHDN1
    SET NBATCH = NBATCH + 1
    IF TI100.PV > TMAX THEN GOTO HOT
    SET FV101.MODATTR = PROGRAM
    CLOSE FV101
    WAIT FV101.PV = CLOSE (WHEN 15 SECS: SEND: "FV101 did not close")
HOT: SEND (WAIT): "Temperature ""high"""
STEP ST02
    LOOP1: LOOP FOR I IN 1..5
      CALL CHECK (NBATCH, FAGIT)
      REPEAT LOOP1
    IF NTEMP IN 10..20 THEN (SET FAGIT = ON;
&                            GOTO STEP ST01)
    ELSE IF NOT BADVAL(NTEMP) THEN SET FAGIT = OFF
    ELSE GOTO HOT
    GOTO PHASE HEAT

    PHASE HEAT (KEEPENB)
    SET T1 = 2 MINS 30 SECS
    START PUMP1
    SET NBATCH = (WHEN NBATCH > 10: 0;
&                 WHEN OTHERS: NBATCH)
    END REACT1

    HOLD HANDLER HLD1 (WHEN FAGIT = ON; INVOKE_IF_ERROR)
    STOP PUMP1
    RESTART
    RESUME PHASE PREPARE
    END HLD1

    SHUTDOWN HANDLER SHDN1
    STOP PUMP1
    END SHDN1

    SUBROUTINE CHECK (N: IN NUMBER; F: OUT LOGICAL)
    IF N > TMAX THEN SET F = ON
    END CHECK
