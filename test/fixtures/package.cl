-- Synthetic CL/AM package: global definitions plus a block and its subroutine.
PACKAGE
  PARAM_LIST VALVE
    PARAMETER PV: NUMBER
  END VALVE
  ENUMERATION COLOR = RED/GREEN/BLUE
  CUSTOM (CLASS GENERAL; NOT BLD_VISIBLE)
    PARAMETER LIMIT "high limit"
      ACCESS ENGINEER
      VALUE 50.0
    PARAMETER TARGET: VALVE
    PARAMETER SHADE: COLOR
    PARAMETER TABLE: NUMBER ARRAY (1..3)
      VALUE (1.0, 2.0, 3.0)
  END CUSTOM
  BLOCK MONITOR (GENERIC; AT BACKGRND (1); ACCESS PROGRAM)
    EXTERNAL A100, NET\B200
    LOCAL X, Y: NUMBER
    DEFINE DIST(P, Q) = SQRT(P * P + Q * Q)
    SET X = DIST(A100.PV, NET\B200.PV)
    IF X > LIMIT THEN SET SHADE = RED
    IF TARGET.PV > 10.0 THEN CALL LOG_IT (X)
    END MONITOR
  SUBROUTINE LOG_IT (V: IN NUMBER)
    LOCAL MSG: STRING
    SEND LOG_ONLY: "value", V
  END LOG_IT
END PACKAGE
